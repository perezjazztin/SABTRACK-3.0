# ==========================================
# SABTRACK API — Environment Configuration
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Connection String
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sabtrack_dev

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# EcoBot AI & Web Search Grounding (100% Free tier from https://aistudio.google.com/)
# Multiple keys can be comma-separated for automatic failover/rotation
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Email & Notification Settings (100% Free via Gmail App Passwords or Local Dev Simulator)
# If SMTP_ENABLED=False or SMTP_PASSWORD is empty, emails are previewed in apps/api/storage/emails/
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="SABTRACK - Barangay Sabang"
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
